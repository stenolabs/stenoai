---
import { ArrowUpRight } from "lucide-react";
import { CTA_BRIEFING } from "../content/industries.data";

// Radar layer over the film: light pulses travelling along the 88px grid lines.
// d = axis, n = line index, t = seconds per pass, del = start offset, a = amber.
const PULSES = [
  { d: "x", n: 2, t: 9, del: -2 },
  { d: "x", n: 5, t: 12, del: -7, a: true },
  { d: "x", n: 8, t: 10, del: -4 },
  { d: "y", n: 1, t: 8, del: -1 },
  { d: "y", n: 3, t: 10, del: -5 },
  { d: "y", n: 9, t: 11, del: -6 },
  { d: "y", n: 14, t: 9.5, del: -3, a: true },
];
---

<section class="mission-hero" aria-labelledby="hero-heading">
  <div class="mission-wrap mission-hero-content">
    <p class="mission-eyebrow"><span class="mission-status-dot"></span> Government, defence & law enforcement</p>
    <h1 id="hero-heading">The record stays<br /><span>in the room.</span></h1>
    <p class="mission-hero-description">AI meeting notes for conversations that can’t be handed to a vendor. Run it on the device, or on infrastructure you control. No meeting bot. Open source.</p>
    <div class="mission-actions">
      <a href={CTA_BRIEFING} class="mission-button mission-button-light" data-track="demo_request" data-location="hero">Request a briefing <ArrowUpRight size={17} aria-hidden="true" /></a>
      <a href="#how" class="mission-text-link">Explore the platform</a>
    </div>
  </div>
  <div class="mission-hero-media">
    <picture>
      <source media="(max-width: 767px)" srcset="/images/enterprise/hero-film-m.webp" width="1080" height="1920" />
      <img class="mission-hero-image" src="/images/enterprise/hero-film.webp" alt="" width="1920" height="1080" fetchpriority="high" />
    </picture>
    <video class="mission-hero-image" muted loop playsinline preload="none" disablepictureinpicture disableremoteplayback aria-hidden="true" tabindex="-1" data-hero-film>
      <source src="/video/hero-film-m.mp4" type="video/mp4" media="(max-width: 767px)" />
      <source src="/video/hero-film.mp4" type="video/mp4" />
    </video>
    <div class="hero-radar-grid" aria-hidden="true"></div>
    <div class="hero-radar" aria-hidden="true">
      <div class="hero-radar-pulses">
        {PULSES.map((p) => <i class:list={["hero-pulse", `hero-pulse-${p.d}`, { "hero-pulse-amber": p.a }]} style={`--n:${p.n};--dur:${p.t}s;--del:${p.del}s`}></i>)}
      </div>
      <div class="hero-radar-scan"></div>
    </div>
  </div>
  <div class="mission-hero-controls">
    <span>Illustrative footage · Local mode</span>
    <button type="button" class="mission-text-link sector-loop-toggle" data-pending data-home-hero-toggle aria-label="Play illustrative footage">Play</button>
  </div>
  <div class="mission-hero-bottom mission-wrap">
    <span>On your device</span>
    <span>On your infrastructure</span>
    <span>Open & inspectable</span>
  </div>
</section>

<style>
  .mission-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .99fr);
    grid-template-rows: minmax(0, 1fr) auto auto;
    min-height: 730px;
    height: min(850px, calc(100svh - 112px));
  }
  .mission-hero-content {
    grid-column: 1;
    grid-row: 1 / 3;
    width: auto;
    margin: 0;
    padding-left: max(56px, calc((100vw - 1440px) / 2));
    padding-right: clamp(10px, 1.3vw, 24px);
    align-self: start;
    padding-top: clamp(110px, 17vh, 166px);
  }
  .mission-hero-media {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 9%), linear-gradient(to bottom, #000 91%, transparent);
    mask-composite: intersect;
  }
  .mission-hero-media .mission-hero-image {
    z-index: 0;
    object-fit: cover;
    object-position: 84% center;
  }
  .mission-hero-media video:not([data-started]) { opacity: 0; }
  .mission-hero-controls {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: end;
    gap: 8px 16px;
    padding: 0 max(56px, calc((100vw - 1440px) / 2)) 0 16px;
    min-height: 44px;
    font-size: 12px;
  }
  .mission-hero-controls .sector-loop-toggle { margin: 0; }
  .mission-hero-bottom { grid-column: 1 / -1; grid-row: 3; }
  .hero-radar, .hero-radar-grid, .hero-radar-pulses, .hero-radar-scan { position: absolute; inset: 0; pointer-events: none; }
  .hero-radar-grid {
    background-image:
      linear-gradient(to right, rgba(236, 234, 227, .13) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(236, 234, 227, .13) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 42%, #000 30%, transparent 80%);
  }
  .mission-hero:not([data-playing]) .hero-pulse, .mission-hero:not([data-playing]) .hero-radar-scan::after { animation-play-state: paused; }
  .hero-radar-pulses {
    overflow: hidden;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 42%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 42%, #000 30%, transparent 80%);
  }
  .hero-pulse { position: absolute; display: block; --c: 127, 214, 192; }
  .hero-pulse-amber { --c: 240, 160, 75; }
  .hero-pulse-x { left: 0; top: calc(var(--n) * 88px); width: 110px; height: 1px; background: linear-gradient(90deg, rgba(var(--c), 0), rgba(var(--c), .95)); box-shadow: 0 0 8px 1px rgba(var(--c), .45); animation: hero-pulse-x var(--dur) linear var(--del) infinite; }
  .hero-pulse-y { top: 0; left: calc(var(--n) * 88px); width: 1px; height: 110px; background: linear-gradient(180deg, rgba(var(--c), 0), rgba(var(--c), .95)); box-shadow: 0 0 8px 1px rgba(var(--c), .45); animation: hero-pulse-y var(--dur) linear var(--del) infinite; }
  @keyframes hero-pulse-x { from { transform: translateX(-140px); } to { transform: translateX(calc(100vw + 140px)); } }
  @keyframes hero-pulse-y { from { transform: translateY(-140px); } to { transform: translateY(1000px); } }
  .hero-radar-scan { overflow: hidden; background: repeating-linear-gradient(180deg, rgba(255, 255, 255, .018) 0 1px, transparent 1px 3px); }
  .hero-radar-scan::after {
    content: ''; position: absolute; left: 0; right: 0; height: 30%; top: -30%;
    background: linear-gradient(180deg, transparent, rgba(240, 160, 75, .05) 70%, rgba(240, 160, 75, .14) 99%, transparent);
    animation: hero-sweep 9s cubic-bezier(.65, 0, .35, 1) 1.2s infinite;
  }
  @keyframes hero-sweep { 0% { transform: translateY(0); } 60%, 100% { transform: translateY(470%); } }
  @media (prefers-reduced-motion: reduce) { .hero-radar-pulses { display: none; } .hero-radar-scan::after { animation: none; display: none; } }

  @media (min-width: 1000px) and (max-width: 1320px) {
    .mission-hero-content { padding-left: 36px; }
    .mission-hero-controls { padding-right: 36px; }
  }
  @media (max-width: 999px) {
    .mission-hero { display: flex; flex-direction: column; height: auto; min-height: 0; }
    .mission-hero-media { order: -2; aspect-ratio: 16 / 9; mask-image: linear-gradient(to bottom, #000 91%, transparent); }
    .mission-hero-media .mission-hero-image { object-position: center top; }
    .mission-hero-controls { order: -1; padding-inline: 32px; }
    .mission-hero-content { align-self: stretch; padding: 20px 32px 40px; }
  }
  @media (max-width: 767px) {
    .mission-hero-media { aspect-ratio: 100 / 86; }
    .mission-hero-controls, .mission-hero-content { padding-inline: 20px; }
    .mission-hero-controls { justify-content: space-between; }
  }

</style>

<script>
  const film = document.querySelector<HTMLVideoElement>('[data-hero-film]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-home-hero-toggle]');
  if (film && toggle) {
    const hero = film.closest('.mission-hero');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let held = motion.matches || !!navigator.connection?.saveData;
    const sync = () => {
      const playing = !film.paused;
      toggle.textContent = playing ? 'Pause' : 'Play';
      toggle.setAttribute('aria-label', playing ? 'Pause illustrative footage' : 'Play illustrative footage');
      hero?.toggleAttribute('data-playing', playing);
    };
    film.addEventListener('play', sync);
    film.addEventListener('pause', sync);
    film.addEventListener('playing', () => { film.dataset.started = ''; }, { once: true });
    sync();
    toggle.removeAttribute('data-pending');
    toggle.addEventListener('click', () => {
      held = !film.paused;
      if (held) film.pause();
      else film.play().catch(sync);
    });
    motion.addEventListener('change', () => {
      if (motion.matches) {
        held = true;
        film.pause();
      }
    });
    if ('IntersectionObserver' in window) {
      const observe = () => {
        new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting && !held) film.play().catch(sync);
          else film.pause();
        }, { threshold: 0.1 }).observe(film);
      };
      if (document.readyState === 'complete') observe();
      else addEventListener('load', observe, { once: true });
    }
  }
</script>
