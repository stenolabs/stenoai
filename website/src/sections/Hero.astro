---
import { ArrowUpRight, ArrowDown, Plus } from "lucide-react";
import { CTA_MAILTO } from "../content/industries.data";
---

<section class="mission-hero" aria-labelledby="hero-heading">
  <video class="mission-hero-image" muted loop playsinline autoplay preload="auto" poster="/images/enterprise/briefing-room.webp?v=3" aria-hidden="true" data-hero-film>
    <source src="/video/briefing-room.mp4?v=5" type="video/mp4" />
  </video>
  <div class="mission-hero-shade" aria-hidden="true"></div>
  <div class="mission-hero-grid" aria-hidden="true"><Plus className="hero-cross hero-cross-one" size={20} /><Plus className="hero-cross hero-cross-two" size={20} /></div>
  <div class="mission-wrap mission-hero-content">
    <p class="mission-eyebrow"><span class="mission-status-dot"></span> Government, defence & law enforcement</p>
    <h1 id="hero-heading">The record stays<br /><span>in the room.</span></h1>
    <p class="mission-hero-description">AI meeting notes for conversations that can’t be handed to a vendor. Run it on the device, or on infrastructure you control. No meeting bot. Open source.</p>
    <div class="mission-actions">
      <a href={CTA_MAILTO} class="mission-button mission-button-light" data-track="demo_request" data-location="hero">Request a briefing <ArrowUpRight size={17} aria-hidden="true" /></a>
      <a href="#how" class="mission-text-link">Explore the platform <ArrowDown size={16} aria-hidden="true" /></a>
    </div>
  </div>
  <div class="mission-hero-caption" aria-hidden="true"><span>Illustrative footage · Local mode</span></div>
  <div class="mission-hero-bottom mission-wrap">
    <span><span class="mission-small-index">01</span> On your device</span>
    <span><span class="mission-small-index">02</span> On your infrastructure</span>
    <span><span class="mission-small-index">03</span> Open & inspectable</span>
    <a href="#how" aria-label="Explore how StenoAI works"><ArrowDown size={20} aria-hidden="true" /></a>
  </div>
</section>
<script>
  // Illustrative film behind the hero. Hold the still poster under reduced
  // motion, and pause while scrolled out of view.
  const film = document.querySelector<HTMLVideoElement>('[data-hero-film]');
  if (film) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      film.removeAttribute('autoplay');
      film.pause();
    } else if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) film.play().catch(() => {});
        else film.pause();
      }, { threshold: 0.1 }).observe(film);
    }
  }
</script>
