---
import { ArrowUpRight } from "lucide-react";
// records: the home page swaps the card pictures for the record objects (scroll.css, scripts/scroll-records.js). Other pages keep the photos.
const { standalone = false, records = false } = Astro.props;
const sectors = [
  { name: 'Government', slug: 'government', rec: 'gov', title: 'For the public interest.\nWithin your perimeter.', body: 'Policy discussions, ministerial briefings and committee meetings. Keep the record where it belongs, with the people responsible for it.', image: 'government', alt: 'People outside a lit office building at dusk', tags: 'Policy · Briefings · Public administration' },
  { name: 'Defence', slug: 'defense', rec: 'def', title: 'Clarity in the room.\nContinuity in the field.', body: 'Planning sessions, programme reviews and debriefs. Capture decisions on your own hardware, even when a connection isn’t an option.', image: 'defence', alt: 'Personnel reviewing documents around a planning table', tags: 'Planning · Reviews · Debriefs' },
  { name: 'Law enforcement', slug: 'law-enforcement', rec: 'le', title: 'Accountable records.\nInside the force.', body: 'Investigation reviews, command meetings and witness contact notes. A transcript behind every summary, kept under your own retention rules.', image: 'law-enforcement', alt: 'Officers in a briefing room', tags: 'Reviews · Command · Safeguarding' },
];
---
<section id="sectors" class:list={["mission-sectors mission-section", { "sectors-standalone": standalone }]} aria-labelledby="sectors-heading">
  <div class="mission-wrap">
    <div class="mission-section-heading">
      <h2 id="sectors-heading">Sensitive conversations</h2>
      <p>When information is sensitive, the tools in the room matter. Give your teams useful AI without handing over their conversations.</p>
    </div>
    <div class="mission-sector-grid">
      {sectors.map((sector) => (
        <a class:list={["mission-sector", { "mission-sector-rec": records }]} href={`/enterprise/${sector.slug}/`} data-rec={records ? sector.rec : undefined}>
          <div class="mission-sector-image">
            {records && <div class="rec" aria-hidden="true"><div class="rec-obj"><canvas></canvas><i class="rec-seam"></i></div><canvas class="rec-wave"></canvas><div class="rec-glow"></div></div>}
            <img src={`/images/enterprise/${sector.image}.webp`} alt={sector.alt} width="1200" height="800" loading="lazy" decoding="async" />
            <div class="mission-sector-image-label"><ArrowUpRight size={24} aria-hidden="true" /></div>
            <h3>{sector.name}</h3>
          </div>
          <div class="mission-sector-body">
            <h4>{sector.title.split('\n').map(line => <span>{line}</span>)}</h4>
            <p>{sector.body}</p>
            <span class="mission-eyebrow mission-sector-tags">{sector.tags}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
