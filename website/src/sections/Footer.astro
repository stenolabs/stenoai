---
import { StenoMark, Wordmark } from '../components/Brand';
import { ThemeToggle } from '../components/ThemeToggle';
import { ArrowUpRight } from 'lucide-react';
const sections = [
  { title: 'Platform', links: [{ href: '/#how', name: 'How it works' }, { href: '/#deploy', name: 'Deployment' }, { href: '/#security', name: 'Security & control' }, { href: '/download/?src=footer', name: 'Download' }, { href: '/#faq', name: 'Questions' }] },
  { title: 'Enterprise', links: [{ href: '/enterprise/', name: 'Overview' }, { href: '/enterprise/government/', name: 'Government' }, { href: '/enterprise/defense/', name: 'Defence' }, { href: '/enterprise/law-enforcement/', name: 'Law enforcement' }] },
  { title: 'Resources', links: [{ href: 'https://docs.stenoai.co', name: 'Documentation', external: true }, { href: 'https://github.com/stenolabs/stenoai', name: 'Source code', external: true, track: 'github' }, { href: 'https://discord.gg/DZ6vcQnxxu', name: 'Community', external: true }, { href: '/vs/', name: 'Compare StenoAI' }] },
];
---
<footer class="mission-footer">
  <div class="mission-wrap">
    <div class="mission-footer-grid">
      <div class="mission-footer-brand"><a href="/" aria-label="StenoAI home"><StenoMark size={34} /><Wordmark size={26} /></a><p>Private meeting intelligence.<br />For the work that matters.</p></div>
      {sections.map(section => <div><h2 class="mission-eyebrow">{section.title}</h2><ul>{section.links.map(link => <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} data-track={link.track} data-location={link.track ? 'footer' : undefined}>{link.name}{link.external && <ArrowUpRight size={12} aria-hidden="true" />}</a></li>)}</ul></div>)}
    </div>
    <div class="mission-footer-bottom"><p class="mission-footer-legal"><span>© {new Date().getFullYear()} StenoAI Pte Ltd</span><span>Singapore&nbsp;098642</span><a href="mailto:support@stenoai.co">support@stenoai.co</a></p><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><ThemeToggle client:load /></div></div>
  </div>
</footer>
