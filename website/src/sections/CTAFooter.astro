---
import { ArrowUpRight, ArrowRight } from 'lucide-react';
import { CTA_BRIEFING } from '../content/industries.data';
---
<section id="download" class="mission-cta">
  <div class="mission-wrap">
    <p class="mission-eyebrow">Your next conversation deserves better.</p>
    <div class="mission-cta-content">
      <h2>Keep the record.<br /><span>Keep control.</span></h2>
      <div><p>See what private meeting intelligence<br />can do for your organisation.</p><a href={CTA_BRIEFING} class="mission-button mission-button-light" data-track="demo_request" data-location="cta_footer">Request a briefing <ArrowUpRight size={17} aria-hidden="true" /></a><a href="/download/?src=cta_footer" class="mission-text-link">Download the open-source app <ArrowRight size={16} aria-hidden="true" /></a></div>
    </div>
    <div class="mission-cta-bottom"><span>Your device or your infrastructure. Never ours.</span><span>macOS · Windows alpha</span></div>
  </div>
</section>
