---
import { ArrowUpRight, ArrowRight, ChevronDown } from 'lucide-react';
import { CTA_BRIEFING } from '../content/industries.data';
// Editions and the buy path in one place: try it free, or take the
// enterprise route from briefing to deployment.
const path = [
  { name: 'Brief', image: 'brief', body: 'A briefing for your team and security lead.' },
  { name: 'Pilot', image: 'pilot', body: 'A pilot on your own meetings and hardware.' },
  { name: 'Assure', image: 'assure', body: 'Source, build and data paths for your security review and DPO.' },
  { name: 'Deploy', image: 'deploy', body: 'Roll out on devices or your infrastructure, through your procurement route.' },
];
---
<section id="editions" class="mission-editions mission-section" aria-labelledby="editions-heading">
  <div class="mission-wrap">
    <div class="mission-section-heading">
      <h2 id="editions-heading">From one laptop to the<br />whole organisation.</h2>
      <p>Try the open-source app on a single laptop today. When a department, unit or force is ready, we take you from briefing to deployment.</p>
    </div>
    <div class="editions-wake" aria-hidden="true">
      {/* Owner 26 Nov 2026: "replace unrealistic images like this ... Only photo realistic images with high detail". */}
      <picture>
        <source media="(max-width: 767px)" srcset="/images/editions/hero-p.webp" width="770" height="440" />
        <img src="/images/editions/hero-d.webp" alt="" width="1680" height="720" loading="lazy" decoding="async" />
      </picture>
    </div>
    <div class="mission-editions-grid">
      <div class="mission-edition">
        <p class="mission-eyebrow">Community</p>
        <h3>Free · MIT licence</h3>
        <img class="editions-community-photo" src="/images/editions/b-community.webp" alt="" width="1200" height="800" loading="lazy" decoding="async" />
        <ul><li>The full on-device pipeline</li><li>No account and no usage caps</li><li>macOS · Windows alpha</li></ul>
        <a href="/download/?src=editions" class="mission-text-link">Download Community <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="mission-edition mission-edition-featured">
        <p class="mission-eyebrow">Enterprise</p>
        <h3>For teams and organisations</h3>
        <ol class="mission-edition-path">
          {/* Owner 26 Nov 2026: "have it more of a pull down theres too much in the home screen". Native details, so it works without JavaScript. */}
          {path.map((step, i) => (
            <li>
              <details name="edition-path">
                <summary>
                  <span class="mission-small-index">0{i + 1}</span>
                  <strong>{step.name}</strong>
                  <ChevronDown class="edition-path-chev" size={18} strokeWidth={1.5} aria-hidden="true" />
                </summary>
                <div class="edition-path-body">
                  <p>{step.body}</p>
                  <img class="editions-step-photo" src={`/images/editions/c-${step.image}.webp`} alt="" width="704" height="528" loading="lazy" decoding="async" />
                </div>
              </details>
            </li>
          ))}
        </ol>
        <a href={CTA_BRIEFING} class="mission-button mission-button-light" data-track="demo_request" data-location="editions">Request a briefing <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </div>
</section>
