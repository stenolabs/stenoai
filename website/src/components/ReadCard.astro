---
import { ArrowRight } from "lucide-react";

interface Props {
  as?: "li" | "article";
  id: string;
  title: string;
  class?: string;
}
const { as: Tag = "article", id, title, class: className } = Astro.props;
---
<Tag id={id} class:list={["rm-card", className]} data-rm-card>
  <slot />
  <button type="button" class="rm-card-open" aria-haspopup="dialog" aria-expanded="false" aria-controls="rm-panel" aria-label={title}>
    <ArrowRight size={16} aria-hidden="true" />
  </button>
</Tag>
