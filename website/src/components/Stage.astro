---
// A pinned scroll stage: the panel stays on screen while the section scrolls through its extra length (see scroll.css).
// With on={false} it renders its children as they are, so other pages keep the section exactly as it is.
// ownFit: the stage decides flow or pinned for itself (scripts/scroll-env.js checkFit) instead of the whole page.
const { on = false, class: cls, ownFit = false } = Astro.props;
---
{on ? <div class:list={["stage", cls]} data-own-fit={ownFit ? "" : undefined}><div class="stage-panel"><slot /></div></div> : <slot />}
