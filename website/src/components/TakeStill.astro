---
// A take that plays by scroll in its own box (scripts/scroll-seq.js, frames drawn on plain black with mix-blend-mode: screen): box, melts into the page. Decorative.
// The still is what shows without JavaScript. <TakeStill src="/x.webp" phone="/y.webp" ratio="1128 / 470" take={{ d: "/scroll/gov/take-x-d", p: "/scroll/gov/take-x-p", frames: 61, key: "x" }} />
// Progress 0 when the box top is at 95% of the viewport, 1 when its centre (the marker) is at 55%; scrolling up plays it back.
import "../scroll-rooms.css";
import ScrollSeq from "./ScrollSeq.astro";
const { src, phone, ratio, width = 1100, take, class: cls } = Astro.props;
const [w, h] = ratio.split("/").map((n) => parseInt(n, 10));
---
<div class:list={["take-still", { "take-seq": !!take }, cls]} aria-hidden="true" style={`aspect-ratio:${ratio};--tw:${width}px`}>
  <picture class="take-fallback"><source media="(max-width: 767px)" srcset={phone} /><img src={src} width={w} height={h} alt="" loading="lazy" decoding="async" /></picture>
  {take && <i class="take-mark" id={`gt-${take.key}`}></i>}
  {take && <ScrollSeq class="seq-take" src={take.d} src-phone={take.p} frames={take.frames} start=".95" end=".55" target={`#gt-${take.key}`} />}
</div>
