---
import { Play } from "lucide-react";
import ScrollSeq from "./ScrollSeq.astro";
// A dark teaser that is the page background: no frame. Its frames play by scroll (scripts/scroll-seq.js); nothing else is fetched
// until the dialog opens (components/FilmDialog.astro). The visible "Watch the film" control sits next to it; the ring on the screen is a mouse
// target only (aria-hidden, not in the tab order) and brightens with either.
const { film, start = ".95", end = ".6" } = Astro.props; // progress 0: box top at 95% of the viewport; 1: the screen's centre (the marker) at 60%
---
<div class="teaser">
  <div class="teaser-box">
    <noscript><img class="teaser-still" src={`/scroll/film-${film.key}-still.webp`} alt="" width="534" height="985" /></noscript>
    <ScrollSeq class="seq-plain" src={`/scroll/film-${film.key}-d`} src-phone={`/scroll/film-${film.key}-p`} frames="73" start={start} end={end} target={`#tm-${film.key}`} rest=".8" />
    <i class="teaser-mark" id={`tm-${film.key}`} aria-hidden="true"></i>
    <button type="button" class="teaser-open" data-film-open={film.slug} tabindex="-1" aria-hidden="true"><span class="teaser-ring"><Play size={22} fill="currentColor" aria-hidden="true" /></span></button>
  </div>
</div>
