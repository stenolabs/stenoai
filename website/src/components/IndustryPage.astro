---
import { Check, ArrowUpRight, X } from "lucide-react";
import { Nav } from "../sections/Nav";
import Footer from "../sections/Footer.astro";
import CTAFooter from "../sections/CTAFooter.astro";
import { ALL, COMPLIANCE_BODY, CTA_BRIEFING, BREACHES_VERIFIED, SECTOR_VERIFIED } from "../content/industries.data.js";
import "../sector.css";

const { data } = Astro.props;
const others = ALL.filter((c) => c.slug !== data.slug);

// Sections are numbered in render order, skipping any the sector doesn't have.
const order = [
  data.useCases && "use-cases",
  data.whyNow && "why-now",
  "cloud",
  data.policy && "policy",
  data.breaches && "case-files",
  data.postures && "postures",
  data.notFor && "not-for",
  "questions",
].filter(Boolean);
const num = (id) => String(order.indexOf(id) + 1).padStart(2, "0");
---

<Nav subpage client:load />

<main id="main-content" class="mission-site sector-page">
  <section class="mission-wrap industry-hero">
    <div>
      <p class="mission-eyebrow">{data.eyebrow}</p>
      <h1>{data.h1}</h1>
      <p>{data.lede}</p>
      <div class="mission-actions">
        <a href={CTA_BRIEFING} data-track="demo_request" data-location={`enterprise_${data.slug}`} class="mission-button mission-button-dark">Request a briefing <ArrowUpRight size={16} aria-hidden="true" /></a>
        <a href="/download/?src=enterprise" class="mission-text-link">Evaluate the app <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="industry-hero-chips"><span>Your device or your infrastructure</span><span>No meeting bot</span><span>Open source</span></div>
    </div>
    <img class="industry-hero-image" src={`/images/enterprise/${data.image}.webp`} alt={data.imageAlt} width="1200" height="800" fetchpriority="high" />
  </section>

  {data.useCases && (
    <section id="use-cases" class="mission-section sector-section" aria-labelledby="use-cases-heading">
      <div class="mission-wrap">
        <div class="mission-section-top"><p class="mission-eyebrow">{num("use-cases")} / Where it is used</p><span class="mission-eyebrow">Illustrative settings · {data.useCases.length}</span></div>
        <div class="mission-section-heading">
          <h2 id="use-cases-heading">Where it is used,<br />room by room.</h2>
          <p>Settings where the conversation can’t be handed to a cloud vendor, and the record StenoAI produces in each, on your device or your infrastructure.</p>
        </div>
        <ol class="sector-cases">
          {data.useCases.map((u) => (
            <li class="sector-case">
              <div class="sector-case-top"><span class="mission-small-index">{u.code}</span><span class="sector-tag">{u.env}</span></div>
              <h3>{u.title}</h3>
              <p class="sector-case-outcome">{u.outcome}</p>
              <p class="sector-case-for"><span class="mission-eyebrow">For</span>{u.for}</p>
              <ul class="sector-case-outputs">{u.outputs.map((o) => <li>{o}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {data.whyNow && (
    <section id="why-now" class="mission-section sector-section sector-sunken" aria-labelledby="why-now-heading">
      <div class="mission-wrap">
        <div class="mission-section-top"><p class="mission-eyebrow">{num("why-now")} / Why now · Public record</p><span class="mission-eyebrow">Verified {SECTOR_VERIFIED}</span></div>
        <div class="mission-section-heading">
          <h2 id="why-now-heading">{data.whyNow.heading}</h2>
          <p>{data.whyNow.intro}</p>
        </div>
        <ol class="sector-timeline">
          {data.whyNow.items.map((item) => (
            <li>
              <p class="mission-eyebrow"><span class="sector-date">{item.date}</span> {item.place}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <div class="sector-sources">
                <a href={item.source.href} target="_blank" rel="noopener noreferrer">{item.source.label}<span class="sr-only"> (opens in a new tab)</span> <ArrowUpRight size={12} aria-hidden="true" /></a>
                {item.extra && <a href={item.extra.href} target="_blank" rel="noopener noreferrer">{item.extra.label}<span class="sr-only"> (opens in a new tab)</span> <ArrowUpRight size={12} aria-hidden="true" /></a>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section id="cloud" class="mission-section sector-section" aria-labelledby="cloud-heading">
    <div class="mission-wrap">
      <div class="mission-section-top"><p class="mission-eyebrow">{num("cloud")} / Structural risk</p><span class="mission-eyebrow">{data.pains.length} points</span></div>
      <div class="sector-cloud">
        <div>
          <h2 id="cloud-heading">Why cloud tools don’t fit.</h2>
          <ul class="sector-pains">{data.pains.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="sector-points">
          {data.points.map((pt) => (
            <div>
              <h3><Check size={15} strokeWidth={2.2} aria-hidden="true" />{pt.h}</h3>
              <p>{pt.b}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {data.policy && (
    <section id="policy" class="mission-section sector-section sector-dark" aria-labelledby="policy-heading">
      <div class="mission-wrap">
        <div class="mission-section-top"><p class="mission-eyebrow">{num("policy")} / Law & policy</p><span class="mission-eyebrow">Verified {SECTOR_VERIFIED}</span></div>
        <div class="mission-section-heading">
          <h2 id="policy-heading">{data.policy.heading}</h2>
          <p>{data.policy.intro}</p>
        </div>
        <div class="sector-policy">
          {data.policy.cards.map((c) => (
            <article class="sector-policy-card">
              <h3 class="mission-eyebrow">{c.law}</h3>
              <dl>
                <div><dt>It says</dt><dd>{c.says}</dd></div>
                <div><dt>So</dt><dd>{c.so}</dd></div>
                <div><dt>Still yours</dt><dd>{c.yours}</dd></div>
              </dl>
              <div class="sector-sources">
                {c.sources.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}<span class="sr-only"> (opens in a new tab)</span> <ArrowUpRight size={12} aria-hidden="true" /></a>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {data.breaches && (
    <section id="case-files" class="mission-section sector-section" aria-labelledby="case-files-heading">
      <div class="mission-wrap">
        <div class="mission-section-top"><p class="mission-eyebrow">{num("case-files")} / Case files · Public record</p><span class="mission-eyebrow">Verified {BREACHES_VERIFIED}</span></div>
        <div class="mission-section-heading">
          <h2 id="case-files-heading">{data.breaches.heading}</h2>
          <p>{data.breaches.intro}</p>
        </div>
        <div class="sector-cases-files">
          {data.breaches.items.map((b, i) => (
            <article class="sector-file">
              <p class="mission-eyebrow"><span class="mission-small-index">Case 0{i + 1}</span> {b.meta}</p>
              <h3>{b.title}</h3>
              <p class="sector-file-what">{b.what}</p>
              <div class="sector-file-why"><p class="mission-eyebrow">What StenoAI changes</p><p>{b.why}</p></div>
              <a class="mission-text-link" href={b.source.href} target="_blank" rel="noopener noreferrer">{b.source.label}<span class="sr-only"> (opens in a new tab)</span> <ArrowUpRight size={14} aria-hidden="true" /></a>
            </article>
          ))}
        </div>
        <p class="sector-note">Each incident is a matter of public record, summarised from the linked source and verified {BREACHES_VERIFIED}. StenoAI is not affiliated with any organisation named here.</p>
      </div>
    </section>
  )}

  {data.postures && (
    <section id="postures" class="mission-section sector-section sector-sunken" aria-labelledby="postures-heading">
      <div class="mission-wrap">
        <div class="mission-section-top"><p class="mission-eyebrow">{num("postures")} / Deployment postures</p><span class="mission-eyebrow">Device → network → tenancy</span></div>
        <div class="mission-section-heading">
          <h2 id="postures-heading">Deployment postures<br />at the edge.</h2>
          <p>One application, three ways to run it. The product doesn’t change; the network around it does, and so does exactly what we can claim.</p>
        </div>
        <div class="sector-postures">
          {data.postures.map((p, i) => (
            <article class="sector-posture">
              <p class="mission-eyebrow"><span class="mission-small-index">Posture 0{i + 1}</span> {p.name}</p>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <ol>{p.steps.map((s) => <li>{s}</li>)}</ol>
              <p class="sector-holds"><span class="mission-eyebrow">What holds</span>{p.holds}</p>
            </article>
          ))}
        </div>
        <p class="sector-note">Use in any classified space needs your accrediting authority’s approval of the device and the audio capture. Accreditation is a function of your own deployment and authorisation process, not the app alone.</p>
      </div>
    </section>
  )}

  {data.notFor && (
    <section id="not-for" class="mission-section sector-section sector-sunken" aria-labelledby="not-for-heading">
      <div class="mission-wrap">
        <div class="mission-section-top"><p class="mission-eyebrow">{num("not-for")} / Not for</p><span class="mission-eyebrow">{data.notFor.length} lines</span></div>
        <div class="mission-section-heading">
          <h2 id="not-for-heading">What it is not for.</h2>
          <p>Lines StenoAI does not cross, and is never presented as crossing.</p>
        </div>
        <div class="sector-notfor">
          {data.notFor.map((n) => (
            <div>
              <h3><X size={15} strokeWidth={2.2} aria-hidden="true" />{n.h}</h3>
              <p>{n.b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sector-section sector-compliance-wrap">
    <div class="mission-wrap">
      <div class="sector-compliance">
        <p class="mission-eyebrow">On compliance</p>
        <p>{COMPLIANCE_BODY}</p>
      </div>
    </div>
  </section>

  <section id="faq" class="mission-faq mission-section" aria-labelledby="faq-heading">
    <div class="mission-wrap mission-faq-layout">
      <div><p class="mission-eyebrow">{num("questions")} / Questions</p><h2 id="faq-heading">Questions your<br />security team will ask.</h2></div>
      <div class="mission-faq-items">
        {data.faqs.map((f, index) => <details><summary><span class="mission-faq-number">0{index + 1}</span><span>{f.q}</span><span class="mission-faq-symbol" aria-hidden="true"></span></summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="sector-section sector-related" aria-labelledby="related-heading">
    <div class="mission-wrap">
      <div class="mission-section-top"><p class="mission-eyebrow" id="related-heading">Related briefings</p><span class="mission-eyebrow">Also built for</span></div>
      <div class="sector-related-grid">
        {others.map((c) => (
          <a class="sector-related-card" href={`/enterprise/${c.slug}/`}>
            <img src={`/images/enterprise/${c.image}.webp`} alt="" width="1200" height="800" decoding="async" />
            <div>
              <p class="mission-eyebrow">{c.eyebrow}</p>
              <h3>{c.name} <ArrowUpRight size={20} aria-hidden="true" /></h3>
              <p>{c.h1}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTAFooter />
</main>

<Footer />
