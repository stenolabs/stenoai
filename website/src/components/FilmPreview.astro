---
import "../films.css";

const { film } = Astro.props;
---
<div class="film-preview" aria-hidden="true">
  <img src={`/images/enterprise/preview-${film.slug}.webp`} alt="" width="544" height="680" loading="lazy" decoding="async" />
  <video muted playsinline loop preload="none" disablepictureinpicture disableremoteplayback
    data-film-preview={film.slug} data-src={`/video/preview-${film.slug}.mp4`}></video>
</div>
<script>
  import "../scripts/scroll-films.js";
</script>
