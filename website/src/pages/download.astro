---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Nav } from '../sections/Nav';
import Footer from '../sections/Footer.astro';
import { ArrowDown, ArrowUpRight } from 'lucide-react';
import AppleIcon from '../components/icons/AppleIcon.astro';
import WindowsIcon from '../components/icons/WindowsIcon.astro';
import { MAC_DMG_URL, WINDOWS_EXE_URL } from '../lib/downloads';
const title = 'Download StenoAI — macOS & Windows';
const description = 'Choose StenoAI for Apple Silicon macOS or Windows. Free, open-source meeting notes with local AI processing.';
---
<BaseLayout title={title} description={description} noindex>
  <Nav client:load />
  <main id="main-content" class="mission-site">
    <section class="mission-wrap download-page">
      <p class="mission-eyebrow">StenoAI / Download</p>
      <h1>Private intelligence.<br />Starts here.</h1>
      <p class="download-intro">The open-source app. On your own device.<br />Choose your platform to get started.</p>
      <div class="download-options">
        <article>
          <AppleIcon size={30} />
          <h2>macOS</h2>
          <p>Apple Silicon · macOS 14.4 or later</p>
          <a href={MAC_DMG_URL} class="mission-button mission-button-dark" data-track="download" data-location="download_page" data-arch="arm64">Download for macOS <ArrowDown size={16} aria-hidden="true" /></a>
          <span>For M1 and later Macs.</span>
        </article>
        <article>
          <WindowsIcon size={30} />
          <h2>Windows <span>Alpha</span></h2>
          <p>Windows 10 / 11 · x64</p>
          <a href={WINDOWS_EXE_URL} class="mission-button mission-button-dark" data-track="download" data-location="download_page" data-arch="win-x64">Download for Windows <ArrowDown size={16} aria-hidden="true" /></a>
          <span>Alpha release. The installer is currently unsigned.</span>
        </article>
      </div>
      <p class="download-model-note">First-run setup downloads the AI models. After setup, the local meeting workflow can run offline.</p>
      <div class="download-install">
        <h2>Getting started.</h2>
        <details open>
          <summary>Installing on macOS <span aria-hidden="true">+</span></summary>
          <ol class="download-steps">
            <li><img src="/images/download-steps/step-1.png" alt="Steno installer in Downloads" width="676" height="454" loading="lazy" /><span><b>01</b> Open the installer from Downloads.</span></li>
            <li><img src="/images/download-steps/step-2.png" alt="Drag Steno into Applications" width="712" height="474" loading="lazy" /><span><b>02</b> Drag Steno into Applications.</span></li>
            <li><img src="/images/download-steps/step-3.png" alt="Steno in Applications" width="712" height="474" loading="lazy" /><span><b>03</b> Open Steno and follow setup.</span></li>
          </ol>
        </details>
        <details><summary>Installing on Windows <span aria-hidden="true">+</span></summary><p>Open the downloaded <strong>.exe</strong> installer and follow the installation prompts. Launch Steno and complete first-run model setup. For managed devices, follow your organisation’s process for evaluating and installing unsigned alpha software.</p></details>
      </div>
      <a href="https://github.com/stenolabs/stenoai" class="mission-text-link" data-track="github" data-location="download_page" target="_blank" rel="noopener noreferrer">Prefer to build from source? <ArrowUpRight size={16} aria-hidden="true" /></a>
    </section>
  </main>
  <Footer />
</BaseLayout>
<script>
  // Keep referral attribution, but record a download only once an installer is chosen.
  const source = new URLSearchParams(window.location.search).get('src') || 'direct';
  document.querySelectorAll<HTMLElement>('[data-track="download"]').forEach((link) => {
    link.dataset.location = `download_page:${source}`;
  });
</script>
<style>
  .download-page { padding-block: 70px 90px; }
  .download-page h1 { margin-top: 26px; font: 450 clamp(45px, 5vw, 72px)/1.03 var(--font-sans); letter-spacing: -.055em; }
  .download-intro { margin-top: 25px; font-size: 16px; color: var(--fg-2); line-height: 1.7; }
  .download-options { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 45px; }
  .download-options article { border: 1px solid var(--border-strong); padding: 30px; background: var(--surface-sunken); }
  .download-options h2 { font-size: 30px; margin-top: 25px; display: flex; align-items: center; gap: 15px; }
  .download-options h2 span { font: 9px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; border: 1px solid var(--border-strong); padding: 6px 8px; }
  .download-options p { color: var(--fg-2); font-size: 13px; margin: 15px 0 25px; }
  .download-options article > span { display: block; margin-top: 18px; font-size: 11px; color: var(--fg-2); }
  .download-model-note { font-size: 12px; color: var(--fg-2); margin-top: 22px; }
  .download-install { margin: 65px 0 30px; }
  .download-install h2 { font-size: 32px; margin-bottom: 30px; }
  .download-install details { border-top: 1px solid var(--border-strong); }
  .download-install details:last-child { border-bottom: 1px solid var(--border-strong); }
  .download-install summary { padding: 24px 0; display: flex; justify-content: space-between; list-style: none; font-size: 15px; cursor: pointer; }
  .download-install summary::-webkit-details-marker { display: none; }
  .download-install details[open] summary > span { transform: rotate(45deg); }
  .download-install details > p { padding-bottom: 25px; max-width: 70ch; font-size: 14px; color: var(--fg-2); line-height: 1.8; }
  .download-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding: 0 0 30px; margin: 0; list-style: none; }
  .download-steps img { width: 100%; height: auto; border: 1px solid var(--border); }
  .download-steps li > span { display: flex; gap: 12px; margin-top: 15px; font-size: 12px; color: var(--fg-2); }
  .download-steps b { font: 10px var(--font-mono); padding-top: 3px; color: var(--fg-1); }
  @media (max-width: 767px) { .download-page { padding-block: 45px 65px; } .download-options, .download-steps { grid-template-columns: 1fr; } .download-options article { padding: 25px; } .download-steps img { max-width: 350px; } .download-steps { gap: 30px; } }
</style>
