---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Nav } from "../sections/Nav";
import Footer from "../sections/Footer.astro";
---

<BaseLayout
  title="Terms of Service | StenoAI"
  description="StenoAI terms of service."
  canonical="https://stenoai.co/terms/"
>
  <style>
    main.legal { max-width: 800px; margin: 0 auto; padding: 56px 24px 80px; }
    main.legal h1 {
      font-family: var(--font-sans);
      font-size: clamp(26px, 3.7vw, 37px);
      font-weight: 500; letter-spacing: -0.035em; line-height: 1.1;
      color: var(--fg-1); margin-bottom: 8px;
    }
    .dateline { font-size: 13px; color: var(--fg-muted); margin-bottom: 48px; }
    .content { display: flex; flex-direction: column; gap: 32px; }
    .content section { display: flex; flex-direction: column; gap: 12px; }
    main.legal h2 {
      font-family: var(--font-sans);
      font-size: 17px; font-weight: 500; letter-spacing: -0.015em;
      color: var(--fg-1);
    }
    main.legal p { color: var(--fg-2); }
    main.legal strong { color: var(--fg-1); font-weight: 600; }
    main.legal ul { color: var(--fg-2); padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
    main.legal a { text-decoration: underline; }
  </style>

  <Nav client:load />

  <main id="main-content" class="legal">
    <h1>Terms of Service</h1>
    <p class="dateline">Last updated: February 15, 2026</p>

    <div class="content">
      <section>
        <h2>Acceptance of terms</h2>
        <p>By downloading and using StenoAI, you agree to these terms. StenoAI is open-source software provided under the terms of its <a href="https://github.com/stenolabs/stenoai/blob/main/LICENSE">license</a>.</p>
      </section>

      <section>
        <h2>Use of the software</h2>
        <p>StenoAI is provided free of charge for personal and professional use. You are responsible for:</p>
        <ul>
          <li>Ensuring you have consent to record meetings in your jurisdiction</li>
          <li>Complying with applicable laws regarding audio recording and data privacy</li>
          <li>Maintaining the security of your device and local data</li>
        </ul>
      </section>

      <section>
        <h2>Disclaimer of warranties</h2>
        <p>StenoAI is provided "as is" without warranty of any kind. Transcription and summarization accuracy depend on audio quality, hardware, and model selection. We do not guarantee the accuracy, completeness, or reliability of AI-generated content.</p>
      </section>

      <section>
        <h2>Limitation of liability</h2>
        <p>To the fullest extent permitted by law, the StenoAI project and its contributors shall not be liable for any indirect, incidental, special, or consequential damages arising from the use of the software.</p>
      </section>

      <section>
        <h2>Changes to these terms</h2>
        <p>We may update these terms from time to time. Changes will be reflected on this page with an updated date. Continued use of StenoAI after changes constitutes acceptance of the revised terms.</p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
