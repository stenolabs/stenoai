<script>
  const boot = () => {
    import('../../scripts/scroll-light.js');
    import('../../scripts/scroll-seq.js');
    import('../../scripts/page-cable.js');
  };
  if (document.readyState === 'complete' || location.hash) boot();
  else addEventListener('load', boot, { once: true });
</script>

<script>
  // Hero take: seamless 8 s loop while in view; pauses when scrolled out of view.
  // The Pause/Play toggle is the WCAG 2.2.2 pause control, matching the sector app demos.
  // Poster only under reduced motion, data saver, or if the browser blocks play(). Nothing is fetched before play().
  const take = document.querySelector('[data-hero-take]');
  const toggle = document.querySelector('[data-hero-toggle]');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches || !!navigator.connection?.saveData;
  if (take && toggle) {
    let held = calm;
    const sync = () => {
      const p = take.paused;
      toggle.textContent = p ? 'Play' : 'Pause';
      toggle.setAttribute('aria-label', p ? 'Play illustrative scene' : 'Pause illustrative scene');
    };
    take.addEventListener('play', sync);
    take.addEventListener('pause', sync);
    sync();
    toggle.removeAttribute('data-pending');
    toggle.addEventListener('click', () => {
      held = !take.paused;
      if (held) take.pause(); else take.play().catch(() => {});
    });
    if ('IntersectionObserver' in window) {
      const observe = () => {
        new IntersectionObserver((entries) => {
          if (entries[entries.length - 1].isIntersecting && !held) take.play().catch(() => {});
          else take.pause();
        }, { threshold: 0.25 }).observe(take);
      };
      if (document.readyState === 'complete') observe();
      else addEventListener('load', observe, { once: true });
    }
  }
</script>

<script>
  const fig = document.querySelector('[data-flow]');
  if (fig) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = !!navigator.connection?.saveData;
    const clamp = (value) => Math.max(0, Math.min(1, value));
    let near = false;
    let inView = false;
    let raf = 0;
    let imagesLoaded = false;
    const desktop = fig.querySelector('.dk');
    const loadImages = () => {
      if (!near || imagesLoaded || saveData || !desktop?.getClientRects().length) return;
      imagesLoaded = true;
      desktop.querySelectorAll('image[data-href]').forEach((image) => {
        const source = image.getAttribute('data-href');
        if (source) image.setAttribute('href', source);
      });
    };
    const lines = [...fig.querySelectorAll('[data-flow-line]')].map((base) => {
      const highlight = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      highlight.setAttribute('d', base.getAttribute('d') || '');
      highlight.classList.add('flow-highlight');
      highlight.setAttribute('pathLength', '1');
      base.after(highlight);
      return { base, highlight };
    });
    const update = () => {
      raf = 0;
      if (motion.matches || saveData || !inView) return;
      const svg = [...fig.querySelectorAll('svg')].find((item) => item.getClientRects().length);
      if (!svg) return;
      const rect = svg.getBoundingClientRect();
      const progress = clamp((innerHeight * 0.85 - rect.top) / (rect.height * 0.85));
      for (const { base, highlight } of lines) {
        if (base.closest('svg') !== svg) continue;
        const start = Number(base.getAttribute('data-a'));
        const end = Number(base.getAttribute('data-b'));
        highlight.style.strokeDashoffset = String(1 - clamp((progress - start) / (end - start)));
      }
    };
    const queue = () => { if (inView && !raf) raf = requestAnimationFrame(update); };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        near = entry.isIntersecting;
        loadImages();
      }, { rootMargin: '150% 0px' }).observe(fig);
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        queue();
      }, { rootMargin: '20% 0px' }).observe(fig);
    }
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', () => { loadImages(); queue(); }, { passive: true });
    addEventListener('pageshow', queue);
    motion.addEventListener('change', queue);
  }
</script>
