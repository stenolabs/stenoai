---
import { ArrowUpRight } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Nav } from "../sections/Nav";
import Footer from "../sections/Footer.astro";
import { CTA_BRIEFING } from "../content/industries.data";
---

<BaseLayout
  title="Page Not Found | StenoAI"
  description="The page you’re looking for doesn’t exist."
  noindex
>
  <Nav client:load />
  <main id="main-content" class="mission-site mission-wrap" style="min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 16px;">
    <h1
      style={{
        fontFamily: "var(--font-sans)",
        fontWeight: 500,
        fontSize: "clamp(37px, 5.18vw, 63px)",
        letterSpacing: "-0.04em",
        color: "var(--fg-1)",
      }}
    >
      Page not found
    </h1>
    <p class="text-fg-2 text-lg">The page you’re looking for doesn’t exist or has moved.</p>
    <div class="mission-actions mt-4 justify-center">
      <a href="/download/?src=404" class="mission-button mission-button-dark">Download StenoAI <ArrowUpRight size={16} aria-hidden="true" /></a>
      <a href={CTA_BRIEFING} class="mission-text-link">Request a briefing <ArrowUpRight size={16} aria-hidden="true" /></a>
      <a href="/" class="mission-text-link">Back to home</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
