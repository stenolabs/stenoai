---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Nav } from "../sections/Nav";
import Hero from "../sections/Hero.astro";
import MissionTrust from "../sections/MissionTrust.astro";
import MissionSectors from "../sections/MissionSectors.astro";
import { MissionPlatform } from "../components/MissionPlatform";
import MissionEditions from "../sections/MissionEditions.astro";
import MissionAssurance from "../sections/MissionAssurance.astro";
import MissionDeploy from "../sections/MissionDeploy.astro";
import MissionThreats from "../sections/MissionThreats.astro";
import MissionFAQ from "../sections/MissionFAQ.astro";
import CTAFooter from "../sections/CTAFooter.astro";
import Footer from "../sections/Footer.astro";

const title = "StenoAI — Private Meeting Notes for Government, Defence & Law Enforcement";
const description =
  "Turn sensitive conversations into clear records. StenoAI records, transcribes and summarises on your device or on infrastructure you control. Built for government, defence, law enforcement and confidential work.";
---

<BaseLayout title={title} description={description} canonical="https://stenoai.co/">
  <Nav client:load />
  <main id="main-content" class="mission-site">
    <Hero />
    <MissionTrust />
    <MissionPlatform client:visible />
    <MissionSectors />
    <MissionDeploy />
    <MissionAssurance />
    <MissionThreats />
    <MissionEditions />
    <MissionFAQ />
    <CTAFooter />
  </main>
  <Footer />
</BaseLayout>
