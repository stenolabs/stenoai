      }
    },
    {
      "name": "body separators survive",
      "content": "---\ntitle: Separators\n---\n## Summary\nBefore --- after\n---\n----\n---suffix\nLast line\n## Transcript\nA\n---\nB",
      "expected": {
        "session_info": {
          "name": "Separators"
        },
        "summary": "Before --- after\n---\n----\n---suffix\nLast line",
        "transcript": "A\n---\nB"
      }
    },
    {
